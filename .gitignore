## EXPO gitignore

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

## NextJS gitignore - Kept during cleanup

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Capacitor build artifacts
/android/.gradle/
/android/local.properties
/android/**/build/
/android/**/.cxx/
/android/app/src/main/assets/public/
/android/app/src/main/assets/capacitor.config.json
/android/app/src/main/assets/capacitor.plugins.json
/android/capacitor-cordova-android-plugins/
/ios/App/Pods/
/ios/App/App/public/
/ios/App/App/capacitor.config.json
/ios/DerivedData/
/ios/capacitor-cordova-ios-plugins/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.development
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated
/public/PrivacyPolicy.html